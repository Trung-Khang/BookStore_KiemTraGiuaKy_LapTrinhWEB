<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<title>Chi tiết đơn hàng | BookStore</title>
<section class="container py-5"><a href="<c:url value='/orders'/>">← Lịch sử đặt hàng</a><h1 class="h2 mt-3">Đơn hàng #<c:out value="${order.id}"/></h1>
    <div class="row g-3 mb-4"><div class="col-md-6"><strong>Trạng thái:</strong> <c:out value="${order.status.label}"/></div><div class="col-md-6"><strong>Ngày đặt:</strong> <c:out value="${order.createdAt}"/></div><div class="col-md-6"><strong>Thanh toán:</strong> <c:out value="${order.paymentMethod}"/></div><div class="col-md-6"><strong>Người nhận:</strong> <c:out value="${order.recipientName}"/></div><div class="col-md-6"><strong>Điện thoại:</strong> <c:out value="${order.recipientPhone}"/></div><div class="col-md-6"><strong>Email:</strong> <c:out value="${order.recipientEmail}"/></div><div class="col-12"><strong>Địa chỉ:</strong> <c:out value="${order.shippingAddress}"/></div></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Sách</th><th>Đơn giá tại lúc đặt</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody><c:forEach items="${order.items}" var="item"><tr><td><c:out value="${item.bookTitle}"/></td><td><fmt:formatNumber value="${item.unitPrice}" type="currency" currencyCode="VND" maxFractionDigits="0"/></td><td><c:out value="${item.quantity}"/></td><td><fmt:formatNumber value="${item.lineTotal}" type="currency" currencyCode="VND" maxFractionDigits="0"/></td></tr></c:forEach></tbody><tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="VND" maxFractionDigits="0"/></th></tr></tfoot></table></div>
</section>
