<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><title>Chi tiết sách</title><div class="container"><h1><c:out value="${book.title}"/></h1><p>ISBN: ${book.isbn}</p><p>Publisher: <c:out value="${book.publisher}"/></p><p>Price: ${book.price} | Quantity: ${book.quantity}</p><p>Authors: <c:forEach items="${book.authors}" var="a"><c:out value="${a.name}"/> </c:forEach></p><a class="btn btn-warning" href="<c:url value='/admin/books/edit'><c:param name='id' value='${book.id}'/></c:url>">Sửa</a> <a href="<c:url value='/admin/books'/>">Quay lại</a></div>
