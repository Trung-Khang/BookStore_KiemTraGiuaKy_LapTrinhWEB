<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><title>Quản lý tác giả</title><div class="container-fluid"><h1>Tác giả</h1><c:if test="${not empty param.success}"><div class="alert alert-success">Thao tác thành công.</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger"><c:out value="${param.error}"/></div></c:if><a class="btn btn-primary mb-3" href="<c:url value='/admin/authors/create'/>">Thêm tác giả</a><table class="table table-bordered bg-white"><thead><tr><th>ID</th><th>Tên</th><th>Ngày sinh</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${authors}" var="a"><tr><td>${a.id}</td><td><c:out value="${a.name}"/></td><td>${a.dateOfBirth}</td><td><a class="btn btn-sm btn-info" href="<c:url value='/admin/authors/view'><c:param name='id' value='${a.id}'/></c:url>">Xem</a> <a class="btn btn-sm btn-warning" href="<c:url value='/admin/authors/edit'><c:param name='id' value='${a.id}'/></c:url>">Sửa</a><form class="d-inline" method="post" action="<c:url value='/admin/authors/delete'/>"><input type="hidden" name="id" value="${a.id}"/><button class="btn btn-sm btn-danger" onclick="return confirm('Xóa tác giả?')">Xóa</button></form></td></tr></c:forEach></tbody></table><jsp:include page="/WEB-INF/views/admin/pager.jsp"/></div>
