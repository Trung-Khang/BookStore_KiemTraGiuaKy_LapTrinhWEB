<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><title>Tác giả</title><div class="container" style="max-width:700px"><h1>${empty author ? 'Thêm tác giả' : 'Sửa tác giả'}</h1><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" action="<c:url value='${empty author ? "/admin/authors/create" : "/admin/authors/edit"}'/>"><c:if test="${not empty author}"><input type="hidden" name="id" value="${author.id}"/></c:if><label class="form-label">Tên tác giả</label><input class="form-control mb-3" name="name" required maxlength="100" value="<c:out value='${author.name}'/>"/><label class="form-label">Ngày sinh</label><input class="form-control mb-3" type="date" name="dateOfBirth" required value="${author.dateOfBirth}"/><button class="btn btn-primary">Lưu</button> <a href="<c:url value='/admin/authors'/>">Hủy</a></form></div>
